<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Group the app and its widget extension share (Shared/DailyWordStore.swift).
     The SAME group must be on both targets or the widget reads an empty store. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.xaviergdelrosario.dino</string>
	</array>
</dict>
</plist>
