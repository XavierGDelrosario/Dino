<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest (required by App Store review since May 2024).

  DINO does NOT track: nothing is shared with data brokers, there is no advertising
  SDK, and no identifier is joined with third-party data. Hence NSPrivacyTracking
  false and an empty NSPrivacyTrackingDomains.

  Collected data — what leaves the device, and only to our own Supabase backend:
    · email address, ONLY for an account the user chooses to create (a guest never
      provides one) — app functionality, linked to the user, not for tracking;
    · saved vocabulary and review history — the product itself; app functionality,
      linked to the user, not for tracking.
    · error diagnostics — when a lookup fails, the server logs the error with a short
      excerpt of the text and the user id (error_log), to fix bugs; linked to the user,
      not for tracking;
    · Google ML Kit (handwriting recognition) — the SDK reports performance metrics,
      usage events and a per-installation identifier to Google; not linked to the user,
      not for tracking. Listed per Google's ML Kit data-disclosure page — RE-CHECK that
      page at submission, it is Google's list, not ours.
  Photos and handwriting strokes are processed ON DEVICE and are not collected.
  Microphone audio is recognised on device where iOS supports it for the language
  (the speech plugin is patched to require it then); otherwise iOS sends it to Apple —
  never to us. Text a user chooses to translate is sent for translation; a paragraph
  translation is display-only, but individual words are cached without the user id.

  Accessed API: user defaults, which the WebView and Capacitor use to persist
  preferences and the session — reason CA92.1 (access to information stored by the
  app itself). Also reason 1C8F.1 (App Group): the app writes the daily-word
  schedule its home-screen widgets read (Shared/DailyWordStore.swift).

  KEEP THIS IN SYNC with the App Store Connect privacy labels — Apple compares the
  two, and a mismatch is a rejection. Re-check when a feature starts sending
  something new (e.g. the LLM features, which would add a new collected type).
-->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
        <string>1C8F.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
